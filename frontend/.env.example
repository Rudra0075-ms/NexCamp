# Copy to .env.local. Vite only exposes variables prefixed with VITE_.
# Where the backend is listening. Leave unset and the app falls back to
# http://localhost:5000 in dev, so a local `npm run dev` in backend/ just works.
VITE_API_URL=https://nex-camp-navy.vercel.app

# The seeded demo student. The app signs in with this automatically on load so a
# judge sees real data immediately; the SIGN IN chip in the status bar switches
# to any other seeded account. Must match backend/.env.
VITE_DEMO_EMAIL=pritish@bput.ac.in
VITE_DEMO_PASSWORD=Campus@2026

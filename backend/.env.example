# Copy to .env and adjust. Never commit the real .env.
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/nex_camp

# Sign your own secret — do not reuse this placeholder
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=nex_token

# The Vite dev server, plus any deployed frontend origin.
# Comma-separated. CORS is restricted to exactly these origins.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Seeded demo accounts (used by npm run seed and by the frontend's demo sign-in)
DEMO_STUDENT_EMAIL=pritish@bput.ac.in
DEMO_STUDENT_PASSWORD=Campus@2026
DEMO_ADMIN_EMAIL=control@bput.ac.in
DEMO_ADMIN_PASSWORD=Control@2026

# ---- gate pass: parent OTP over SMS ---------------------------------------
# Leave SMS_PROVIDER=console and the server prints the OTP to its own log and
# delivers nothing. The whole gate-pass flow is runnable this way — no account,
# no credentials, no cost. Switch to a real provider for production.
#
#   console  development default; message written to the server log only
#   http     any JSON SMS gateway (MSG91, Fast2SMS, TextLocal, …)
#   twilio   Twilio Messages API
SMS_PROVIDER=console

# Required when SMS_PROVIDER=http or twilio. Never commit real values.
# http   -> the gateway's send endpoint;  twilio -> https://api.twilio.com/2010-04-01/Accounts/<SID>/Messages.json
SMS_PROVIDER_URL=
# http   -> the gateway API key;          twilio -> the Account SID
SMS_PROVIDER_API_KEY=
# http   -> unused;                       twilio -> the Auth Token
SMS_PROVIDER_API_SECRET=
# http   -> the approved 6-char sender/header;  twilio -> the sending number
SMS_SENDER_ID=CAMPUS

# Only needed if your gateway names its JSON fields differently.
SMS_PROVIDER_TO_FIELD=to
SMS_PROVIDER_MESSAGE_FIELD=message
SMS_PROVIDER_SENDER_FIELD=sender
SMS_PROVIDER_AUTH_HEADER=authorization
SMS_PROVIDER_AUTH_SCHEME=Bearer
SMS_TIMEOUT_MS=8000

# ---- gate pass: policy ----------------------------------------------------
GATE_PASS_OTP_TTL_MINUTES=10
GATE_PASS_OTP_MAX_ATTEMPTS=5
GATE_PASS_OTP_MAX_SENDS=5
GATE_PASS_OTP_RESEND_SECONDS=60
GATE_PASS_MAX_HOURS=12
GATE_PASS_SWEEP_SECONDS=30

# Development and demo only: returns the OTP in the API response so the flow
# can be shown without a live gateway. Ignored when NODE_ENV=production.
GATE_PASS_REVEAL_OTP=true

# Placeholder guardian number written onto the seeded students. Not a real
# number — replace it if you want the seeded demo to send an actual SMS.
DEMO_PARENT_PHONE=+910000000000

# ---- AI provider ----------------------------------------------------------
# Leave AI_API_KEY empty and the whole application still works: every AI
# surface reports AI_NOT_CONFIGURED and runs the deterministic service behind
# it. Nothing is faked — no model name and no confidence figure is shown for
# work a model did not do.
#
# AI_PROVIDER accepts:
#   anthropic   the Anthropic Messages API
#   openai      any OpenAI-compatible /v1/chat/completions endpoint, which also
#               covers Groq, Together, OpenRouter, Ollama and most local runtimes
#
# The key is read by the backend only. It is never sent to the browser, never
# logged, and never included in an API response.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional. Defaults to the provider's own endpoint; set it for a self-hosted
# or proxied gateway (e.g. http://localhost:11434 for Ollama).
AI_BASE_URL=

# A slow provider must never hold up a complaint submission, so calls are cut
# off here and the deterministic fallback answers instead.
AI_TIMEOUT_MS=12000
AI_MAX_OUTPUT_TOKENS=900

# Anthropic only; ignored by the OpenAI-compatible adapter.
AI_API_VERSION=2023-06-01

# Ceiling on how much campus text one prompt may carry, so a large database
# never turns into a large bill or a slow request.
AI_MAX_INPUT_CHARS=12000

# Example — Anthropic:
#   AI_PROVIDER=anthropic
#   AI_API_KEY=sk-ant-...
#   AI_MODEL=claude-sonnet-5
#
# Example — an OpenAI-compatible gateway:
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini

# ---- PS07 extension pack (all optional) -------------------------------------
# Shared secret the SMS provider sends in the x-sms-webhook-secret header when
# it posts an inbound message to /api/sms/inbound. Leave empty and the webhook
# answers 503; the on-screen SMS simulator works either way.
SMS_WEBHOOK_SECRET=
# Set to false if your gateway takes the reply from the webhook response and
# must not be sent a separate outbound SMS.
SMS_REPLY_VIA_PROVIDER=true
# Where certificate QR codes point. Defaults to the first CLIENT_URL.
VERIFY_BASE_URL=
# How often the notice digest / SMS escalation / fee reminder sweep runs.
EXT_MONITOR_SECONDS=60

# ---- Silent Support System (all optional) -----------------------------------
# Student wellbeing check-ins and private support requests. See
# CHANGES-SILENT-SUPPORT.md. Uses the AI_* settings above for optional wording
# only; support bands are always decided by rules, and nothing breaks without AI.
#
# Contacts are set by the institution — no number is built in. Entries are
# separated by ";" and written "Label|contact|note" (note optional), e.g.
#   SUPPORT_EMERGENCY_CONTACTS=Campus Security (24x7)|<number>;Medical Centre|<extension>|Ground floor
#   SUPPORT_HELP_RESOURCES=Counselling Centre|Room <n>, Admin Block|Mon–Sat 9:00–17:00
# Leave empty and students are shown generic guidance instead of an invented number.
SUPPORT_EMERGENCY_CONTACTS=
SUPPORT_HELP_RESOURCES=
# An explicit "I don't feel safe right now" alerts the support team at once.
SUPPORT_AUTO_ESCALATE_IMMEDIATE=true
# Check-in answers are deleted automatically after this many days (minimum 7).
SUPPORT_CHECKIN_RETENTION_DAYS=90
# Admin overview hides any count between 1 and this minus one.
SUPPORT_MIN_CELL_SIZE=3
# Seeded support-team account (npm run seed / npm run seed:support).
DEMO_COUNSELLOR_EMAIL=care@bput.ac.in
DEMO_COUNSELLOR_PASSWORD=Care@2026
